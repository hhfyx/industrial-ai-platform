# 复制成 .env 再启动：cp .env.example .env
# .env 已被 .gitignore 和 .dockerignore 双重排除 —— 配置只在运行时注入，不烤进镜像。

# 容器内监听端口：uvicorn 用它。宿主机映射固定 8000:8000，改这里宿主机就连不上。
# 想练"写错环境变量看启动失败"，把它改成 PORT=abc 再 docker compose up -d。
PORT=8000

# 环境标识（给将来的配置/日志用，当前代码尚未读取）
APP_ENV=development

# ---------------------------------------------------------------- LLM 接入
# 这五行由 app/core/config.py 的 LLMSettings 读取（env_prefix="LLM_"）。
# 注意是**扁平**命名：LLM_API_KEY，而不是 LLM__API_KEY（双下划线是 env_nested_delimiter 那一套）。

# 必填。不要留空（空串会被 _reject_blank_key 在启动时拦下）；真实密钥永不入库。
LLM_API_KEY=sk-local-dev-placeholder-replace-me

# OpenAI 兼容端点，含 /v1；末尾斜杠会被自动去掉
LLM_BASE_URL=http://127.0.0.1:8326/v1

# 模型名（各网关前缀不同，见 learn/llm/01_params.md 的实测记录）
LLM_MODEL=deepseek-account/deepseek-flash

# 单次 HTTP 往返超时（秒）；整体最坏耗时 ≈ timeout × (1 + max_retries)
LLM_TIMEOUT=30

# SDK 内部重试次数：0=不重试，上限 5（ge=0, le=5 由 config.py 校验）
LLM_MAX_RETRIES=2
