# Streamlit secrets 模板 —— 复制成 `.streamlit/secrets.toml` 后填真值。
#
# ============================================================================
# ## 用法（两种场景，同一份内容）
# ============================================================================
#
# ### 本地开发
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#     # 然后把下面的占位符换成真值
#
# `.streamlit/secrets.toml` 已在 `.gitignore` 里 —— **key 不会被提交**。
# 真值请只写在 `secrets.toml`（被忽略的那个），不要写回本文件（会入库）。
#
# ### 部署到 Streamlit Community Cloud
#
# 把下面**除注释外**的内容原样粘进部署对话框的
# **Advanced settings → Secrets** 框里。
# 部署后也可以随时在 app settings 里改。
#
# ============================================================================
# ## ⚠️ 为什么这些键必须放在**根级**，不能放进 `[section]`
# ============================================================================
#
# Streamlit 官方文档原文：
#
#   > # Everything in this section will be available as an environment variable
#   > db_username = "Jane"
#   > db_password = "mypassword"
#   >
#   > # The contents of sections as shown below will **not** become environment
#   > # variables
#   > [my_other_secrets]
#   > things_i_like = ["Streamlit", "Python"]
#
# 也就是说：
#
#   根级的键  ->  同时进 `os.environ`          ✅ 本项目需要这个
#   section 里的键  ->  只能通过 `st.secrets` 读  ❌ 本项目读不到
#
# 本项目用 **pydantic-settings** 从环境变量读 `LLM_*`
# （见 `app/core/config.py` 的 `LLMSettings`，`env_prefix="LLM_"`），
# **代码里没有也不应有 `st.secrets` 的读取**：
# 那会让核心配置依赖 Web 框架，破坏"同一份代码在 CLI / API / UI 下行为一致"。
#
# 所以：**只要键名写对、放在根级，部署时不改任何代码就能生效。**
#
# 反例（会静默失效，app 起来但一问就 502）：
#
#     [llm]                      # ← 加了这个 section，下面三行就进不了环境变量
#     LLM_API_KEY = "sk-..."
#
# ============================================================================

# ---------------------------------------------------------------- LLM（必填）
#
# 不填的后果不是"app 起不来"，而是**上传、检索、引用都正常，只有生成答案报 502**。
# 这种"看起来能跑但一问就错"的状态比彻底失败更难解释，所以要么填真值，
# 要么在 UI 上明确标注"生成不可用"。

LLM_API_KEY = "sk-replace-me"

# **必须公网可达。** 本地默认的 `http://127.0.0.1:8326/v1` 是你机器上的网关 ——
# 部署到 Cloud 后 `127.0.0.1` 指 Cloud 容器自己，那里什么都没有。
# 详见 docs/deploy-notes.md §线上可用的三条路
LLM_BASE_URL = "https://api.deepseek.com/v1"

# 模型名带供应商前缀，各网关前缀不同。
# ⚠️ 写错会返回**完全误导性**的 502「未配置凭据，请先登录」——
# 那是"模型名不认识"，不是"没登录"。查真实 id:
#   curl -H "Authorization: Bearer $LLM_API_KEY" <base_url>/models
LLM_MODEL = "deepseek-chat"

LLM_TIMEOUT = 30
LLM_MAX_RETRIES = 2

# ---------------------------------------------------------------- RAG（可选）
#
# 部署侧默认 `hashing`（~1 MB，只有字面相似）——因为免费层 1 GB 装不下 bge（561 MB）。
# 要显式指定时解开下面一行（付费层 / 本地想强制走 bge 时也一样）。
#
# RAG_EMBEDDER = "hashing"
